<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ControlTemplate x:Key="LanButtonTemplate" TargetType="Button">
  <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8"
          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
          Padding="{TemplateBinding Padding}">
   <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="Center" RecognizesAccessKey="True"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
    <Setter TargetName="Frame" Property="BorderBrush" Value="#FF9B47"/>
   </Trigger>
   <Trigger Property="IsPressed" Value="True">
    <Setter TargetName="Frame" Property="Opacity" Value="0.72"/>
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter Property="Opacity" Value="0.38"/>
   </Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style x:Key="LanButton" TargetType="Button">
  <Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#FAF5F0"/>
  <Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="22,14"/><Setter Property="Margin" Value="0,5"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="BorderBrush" Value="#3B3531"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Template" Value="{StaticResource LanButtonTemplate}"/>
 </Style>
 <Style x:Key="RoomMenuButton" TargetType="Button" BasedOn="{StaticResource LanButton}">
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Padding" Value="10,6"/>
  <Setter Property="Margin" Value="0,2"/>
 </Style>
 <Style x:Key="RoomMenuToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="#F5EEE8"/>
  <Setter Property="Background" Value="#292929"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6"
             BorderThickness="1" BorderBrush="#3B3531" Padding="8,2">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Frame" Property="BorderBrush" Value="#FF9B47"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Frame" Property="Background" Value="#5B341C"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="LanText" TargetType="TextBlock"><Setter Property="Foreground" Value="#F1ECE7"/><Setter Property="FontSize" Value="17"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/></Style>
 <Style x:Key="LanInput" TargetType="TextBox"><Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#49413A"/><Setter Property="BorderThickness" Value="1"/></Style>
</ResourceDictionary>
