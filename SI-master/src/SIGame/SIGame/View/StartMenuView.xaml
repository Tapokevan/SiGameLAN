<UserControl x:Class="SIGame.View.StartMenuView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="#111111"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="1000" Margin="50,60">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center">
  <TextBlock Text="СИ" FontSize="100" FontWeight="Bold" Foreground="#FF9B47"/>
  <TextBlock Text="Домашняя игра" Foreground="White" FontSize="40" FontWeight="SemiBold"/>
  <TextBlock Text="Собирайтесь в одной сети. Выбирайте темы, жмите на кнопку и отвечайте вслух." Style="{StaticResource LanText}" Margin="0,24,25,0"/>
  <TextBlock Text="Вопросы из .siq · до 10 игроков · отдельный ведущий" Style="{StaticResource LanText}" Foreground="#AAA39D" Margin="0,24,25,0"/>
 </StackPanel>
 <Border Grid.Column="2" Background="#202020" CornerRadius="18" Padding="28" VerticalAlignment="Center"><StackPanel>
  <TextBlock Text="Ваше имя" Style="{StaticResource LanText}"/>
  <TextBox Text="{Binding Human.HumanPlayer.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Style="{StaticResource LanInput}" Margin="0,4,0,22"/>
  <ItemsControl ItemsSource="{Binding MainCommands}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Header}" Command="{Binding Command}" Style="{StaticResource LanButton}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Создатель комнаты становится ведущим. Остальные подключаются по его IP." Style="{StaticResource LanText}" Foreground="#AAA39D" FontSize="14" Margin="0,20,0,0"/>
 </StackPanel></Border>
 </Grid></ScrollViewer></Grid>
</UserControl>