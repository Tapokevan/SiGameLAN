<UserControl x:Class="SIGame.NewGameView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lc="clr-namespace:SIGame.Converters" xmlns:ps="clr-namespace:SIGame.ViewModel.PackageSources;assembly=SIGame.ViewModel">
 <UserControl.Resources><lc:AccountTypeToBooleanConverter x:Key="AccountTypeBoolean"/></UserControl.Resources>
 <Grid Background="#111111"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="35,20" MaxWidth="1000">
 <TextBlock Text="Комната ведущего" Style="{StaticResource LanText}" FontSize="34"/>
 <TextBlock x:Name="LocalAddresses" Style="{StaticResource LanText}" Foreground="#FF9B47"/>
 <TextBlock Text="Пакет вопросов" Style="{StaticResource LanText}" Margin="0,20,0,4"/>
 <Button Content="Открыть файл .siq" Command="{Binding SelectPackage}" CommandParameter="{x:Static ps:PackageSourceTypes.Local}" Style="{StaticResource LanButton}" HorizontalAlignment="Left"/>
 <TextBlock Text="{Binding Package}" Style="{StaticResource LanText}" Foreground="#AAA39D"/>
 <StackPanel Orientation="Horizontal" Margin="0,20,0,15"><TextBlock Text="Мест для игроков" Style="{StaticResource LanText}"/><Slider Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PlayersCount}" Width="260" Margin="20,0"/><TextBlock Text="{Binding PlayersCount}" Style="{StaticResource LanText}" FontWeight="Bold"/></StackPanel>
 <ItemsControl ItemsSource="{Binding Players}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
 <Border Background="#202020" CornerRadius="10" Margin="5" Padding="12"><StackPanel>
 <CheckBox Content="Бот" IsChecked="{Binding AccountType, Converter={StaticResource AccountTypeBoolean}}" Foreground="White" FontSize="17" Margin="0,0,0,8"/>
 <ComboBox ItemsSource="{Binding SelectionList}" SelectedItem="{Binding SelectedAccount}" FontSize="16" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Foreground="#202020"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Name}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value=" "><Setter Property="Text" Value="Свободное место"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
 </StackPanel></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Оставьте свободные места для друзей или включите ботов. После подключения игроки нажимают «Готов», затем ведущий запускает игру." Style="{StaticResource LanText}" Foreground="#AAA39D" FontSize="14" Margin="0,18,0,8"/>
 <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9D9D" TextWrapping="Wrap"/>
 <Button Content="Открыть комнату" Command="{Binding BeginGame}" Style="{StaticResource LanButton}" Background="#A64D19"/>
 <TextBlock Text="{Binding LoadingStatus}" Style="{StaticResource LanText}" FontSize="14"/><ProgressBar IsIndeterminate="{Binding IsProgress}" Height="4"/>
 </StackPanel></ScrollViewer></Grid>
</UserControl>
