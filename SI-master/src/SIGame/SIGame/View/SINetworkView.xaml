<UserControl x:Class="SIGame.SINetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:data="clr-namespace:SIData;assembly=SIData">
 <Grid Background="#111111"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" Margin="40">
 <Button Content="← Назад" Command="{Binding Cancel}" Style="{StaticResource LanButton}" HorizontalAlignment="Left"/>
 <TextBlock Text="Подключение к комнате" Style="{StaticResource LanText}" FontSize="36" Margin="0,30,0,20"/>
 <TextBlock Text="IP компьютера ведущего" Style="{StaticResource LanText}"/>
 <TextBox Text="{Binding Address, UpdateSourceTrigger=LostFocus}" Style="{StaticResource LanInput}"/>
 <Button Content="Найти комнату" Command="{Binding Connect}" Style="{StaticResource LanButton}" Margin="0,18,0,10"/>
 <ProgressBar IsIndeterminate="{Binding IsProgress}" Height="4"/>
 <TextBlock Text="{Binding Error}" Foreground="#FF9D9D" FontSize="16" TextWrapping="Wrap" Margin="0,15"/>
 <StackPanel Visibility="{Binding Connected, Converter={StaticResource BooleanToVisibilityConverter1}}">
 <TextBlock Text="Комната найдена" Style="{StaticResource LanText}" Foreground="#FF9B47"/>
 <Button Content="Войти игроком" Command="{Binding Join}" CommandParameter="{x:Static data:GameRole.Player}" Style="{StaticResource LanButton}"/>
 <Button Content="Смотреть игру" Command="{Binding Join}" CommandParameter="{x:Static data:GameRole.Viewer}" Style="{StaticResource LanButton}"/>
 </StackPanel>
 <TextBlock Text="Подключитесь к тому же роутеру по Wi-Fi или кабелю. IP ведущего показан в окне создания комнаты." Style="{StaticResource LanText}" Foreground="#AAA39D" FontSize="14"/>
 </StackPanel></ScrollViewer></Grid>
</UserControl>